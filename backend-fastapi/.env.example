# ArtisanLoft Backend — Environment Variables
# Copy this to .env and fill in real values. NEVER commit .env to git.

# Postgres (Supabase > Connect > ORMs/SQLAlchemy — use the pooler connection string)
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres

# Supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>

# Auth — Phase 3 will replace this with Supabase JWT verification
JWT_SECRET=<random-secret-min-32-chars>
JWT_EXPIRE_MINUTES=60

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# App
FRONTEND_URL=http://localhost:3000
ENV=development

# Optional: Unsplash API key for re-fetching product images
UNSPLASH_ACCESS_KEY=<unsplash-access-key>
