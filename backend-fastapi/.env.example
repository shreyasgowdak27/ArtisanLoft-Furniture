# ArtisanLoft Backend — Environment Variables
# Copy this file to .env and fill in real values. NEVER commit real secrets to git.

# Database — Supabase Postgres asyncpg connection string (use the pooler URL in production)
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres

# Supabase Auth — Used for JWT signature verification via JWKS
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>

# JWT Authentication
JWT_SECRET=<random-secret-min-32-chars>
JWT_EXPIRE_MINUTES=60

# CORS — Comma-separated list of allowed frontend origins (no trailing slashes)
CORS_ORIGINS=http://localhost:3000

# Application & Deployment
FRONTEND_URL=http://localhost:3000
ENV=development
PORT=8000

# External Integrations (Optional)
UNSPLASH_ACCESS_KEY=<unsplash-access-key>
